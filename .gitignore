# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local Vitru state (pending plans, sessões de conversa, inbox, log de interações — dados de aluno/execução, não de código)
.vitru/*.local.json
.vitru/*.local.log

# banco de desenvolvimento (PGlite). ~60 MB de cluster Postgres binário —
# reconstruível a qualquer momento com `npm run db:reset`.
.vitru/pglite/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
