{"nodes": [{"id": "_claude_skills_graphify_references_query_query_expansion", "label": "Constrained Query Vocabulary Expansion", "file_type": "rationale", "rationale": "graphify's query CLI (and its inline fallback) matches nodes via case-folded substring + IDF with no stemming, no synonyms, and no cross-language matching; a wording mismatch between the user's question and the graph's node-label vocabulary silently collapses the answer to zero hits. Expanding the query against the graph's own extracted label vocabulary before traversal - selecting only tokens that actually exist in that vocabulary, never inventing new ones - fixes the mismatch without hallucinating false matches.", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_query_graphify_query", "label": "/graphify query (BFS/DFS Traversal)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_query_graphify_path", "label": "/graphify path", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_query_graphify_explain", "label": "/graphify explain", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_query_save_result", "label": "save-result Feedback Loop", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, 