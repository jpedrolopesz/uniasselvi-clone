# ============================================
# Vitru AVA — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env.local e preencha com suas credenciais.
# Em desenvolvimento local, apenas DATABASE_DRIVER=pglite é necessário.

# --- Database ---
# pglite (default, sem dependências) | postgres | aws-data-api
DATABASE_DRIVER=pglite
# DATABASE_URL=postgresql://user:pass@localhost:5432/vitru

# Aurora Serverless (produção)
# AURORA_CLUSTER_ARN=arn:aws:rds:us-east-1:123456789:cluster:vitru-prod
# AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789:secret:vitru-db
# AURORA_DATABASE=vitru

# --- AWS ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# --- Salesforce ---
# SALESFORCE_INSTANCE_URL=https://sua-org.my.salesforce.com
# SALESFORCE_CLIENT_ID=seu_connected_app_client_id
# SALESFORCE_CLIENT_SECRET=seu_client_secret
# SALESFORCE_USERNAME=integration@suaorg.com
# SALESFORCE_PASSWORD=senha+security_token

# --- AWS Cognito (auth) ---
# COGNITO_USER_POOL_ID=us-east-1_xxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Vitru Voice Service (opcional) ---
# NEXT_PUBLIC_VITRU_VOICE_URL=http://localhost:3001
